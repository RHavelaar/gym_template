# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# ngrok (local domain + optional authtoken; use ngrok.yml.example as template)
ngrok.yml

# cursor local debug
.cursor/debug*.log

# supabase local CLI state
supabase/.temp/
supabase/.branches/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# tooling caches
.eslintcache
.swc/

# logs
*.log

# e2e (Playwright optional peer)
test-results/
playwright-report/
blob-report/

# clerk / supabase local
.clerk/
supabase/.env.local
