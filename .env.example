# =============================================================================
# Memberfloor — copy to .env.local and fill in values
# cp .env.example .env.local
# =============================================================================
#
# Demo mode: leave Clerk and Supabase sections empty — public pages and member
# flows use in-memory demo data.
#
# Full stack: set Clerk + Supabase publishable keys (required). Add secret key
# and webhook signing secret when you enable profile sync via Clerk webhooks.

# --- App ---------------------------------------------------------------------

# Active gym config (src/config/gyms/*.ts)
NEXT_PUBLIC_GYM_SLUG=iron-asylum

# --- Vercel (link project + AI Gateway — no deploy required) -----------------
# 1. vercel link --yes --scope <team> --project gym-template
# 2. Enable AI Gateway: Vercel dashboard → Project → Settings → AI Gateway
# 3. vercel env pull .env.local --yes   → adds VERCEL_OIDC_TOKEN (~12–24h TTL)
# Re-run step 3 when local AI calls fail with auth errors.
# Optional static key instead of OIDC: AI_GATEWAY_API_KEY=
# https://vercel.com/docs/ai-gateway

# --- Vercel AI Gateway (brand assistant on /admin/settings/brand) -----------
#
# Tier toggle — development (default) uses cheaper models; production uses higher quality.
# AI_MODEL_TIER=development
# AI_MODEL_TIER=production
#
# Defaults (see src/lib/ai/model-tiers.ts):
#   development  review: openai/gpt-4o-mini
#   production   review: google/gemini-2.5-flash
#
# Per-tier overrides (optional):
# BRAND_REVIEW_MODEL_DEVELOPMENT=
# BRAND_REVIEW_MODEL_PRODUCTION=
#
# Global override — beats tier presets when set:
# BRAND_REVIEW_MODEL=

# --- ngrok (local public URL) ------------------------------------------------
# Free static dev domain: https://dashboard.ngrok.com/domains
# Used by `npm run tunnel` when ngrok.yml is not present.
# Also whitelisted in next.config.ts for dev HMR when browsing via ngrok.
# NGROK_STATIC_DOMAIN=your-id.ngrok-free.dev
# Optional extra hosts (comma-separated hostnames or URLs):
# NEXT_ALLOWED_DEV_ORIGINS=other-tunnel.ngrok-free.dev

# --- Clerk (https://dashboard.clerk.com) -------------------------------------

# API keys → https://dashboard.clerk.com/~/api-keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Paths (optional — match ClerkProvider / Dashboard → Paths)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# Webhook signing secret (Dashboard → Webhooks → endpoint → Signing secret, whsec_...)
# Required only for syncing Clerk users into Supabase profiles.
CLERK_WEBHOOK_SIGNING_SECRET=

# --- Supabase (https://supabase.com/dashboard → Project Settings → API) ------

# Project URL
NEXT_PUBLIC_SUPABASE_URL=

# Publishable key (sb_publishable_...) — safe for browser and server clients with RLS
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Secret key (sb_secret_...) — server-only; never NEXT_PUBLIC_*
# Used by /api/webhooks/clerk to upsert profiles (bypasses RLS). Not needed for demo mode
# or read-only member pages once Clerk JWT + third-party auth are configured.
SUPABASE_SECRET_KEY=
