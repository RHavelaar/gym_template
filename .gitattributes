# Auto detect text files and perform LF normalization
* text=auto

# Shell scripts — always LF
*.sh text eol=lf
scripts/* text eol=lf

# Binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary

# Lockfile — calmer diffs in review
package-lock.json -diff linguist-generated=true
