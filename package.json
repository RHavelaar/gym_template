{
  "name": "gym_template",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "prebuild": "npm run test",
    "start": "next start",
    "lint": "eslint --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "lint:tailwind": "vitest run src/lib/lint/tailwind-class-syntax.test.ts",
    "lint:md": "markdownlint-cli2",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "prepare": "husky",
    "clerk": "clerk",
    "clerk:login": "clerk auth login",
    "clerk:link": "clerk link",
    "clerk:env": "clerk env pull",
    "clerk:doctor": "clerk doctor",
    "tunnel": "bash scripts/tunnel.sh"
  },
  "dependencies": {
    "@ai-sdk/gateway": "^3.0.121",
    "@clerk/nextjs": "^7.4.2",
    "@clerk/ui": "^1.14.0",
    "@react-pdf/renderer": "^4.5.1",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.106.2",
    "ai": "^6.0.193",
    "clsx": "^2.1.1",
    "lucide-react": "^1.17.0",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-colorful": "^5.7.0",
    "react-dom": "19.2.4",
    "resend": "^6.12.4",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "clerk": "^1.5.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "eslint-config-prettier": "^10.1.5",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "markdownlint-cli2": "^0.22.1",
    "prettier": "^3.5.3",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^3.2.4"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{css,json}": "prettier --write",
    "*.{md,mdc}": [
      "prettier --write",
      "markdownlint-cli2 --fix"
    ]
  }
}
